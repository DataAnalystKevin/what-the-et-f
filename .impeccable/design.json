  "narrative": {
    "northStar": "Der Brief vom Freund",
    "overview": "Die Seite liest sich wie ein gut gesetzter, persönlicher Brief auf warmem Papier: eine einzelne Spalte, eine Serifenschrift, eine Farbe, die etwas bedeutet. Sie erklärt Geldanlage für Menschen, die Angst davor haben, und darf deshalb nirgends nach Bank, Broker oder Verkaufsgespräch aussehen. Ruhe ist das Gestaltungsmittel.",
    "keyCharacteristics": [
      "Eine Familie (Literata, variabel mit optischer Größe) für alles.",
      "Ein Akzent: Moosgrün.",
      "Flache Karten mit feiner Linie auf Papier; Schatten nur beim Menü.",
      "Eine einzige Eckenform (6px).",
      "Hell und Dunkel gleichberechtigt.",
      "Gefüllte Flächen sind knapp: gefüllt bleibt nur der eine Weiter-Schritt."
    ],
    "rules": [
      { "name": "The One Moss Rule", "body": "Moosgrün ist die einzige Akzentfarbe. Es trägt Bedeutung, nie Dekoration.", "section": "colors" },
      { "name": "The Twin Rule", "body": "Jedes Token existiert in Hell und Dunkel mit dokumentiertem Kontrast.", "section": "colors" },
      { "name": "The Never-Color-Alone Rule", "body": "Vorteil, Fehler und Fortschritt tragen zusätzlich ein Zeichen oder Text.", "section": "colors" },
      { "name": "The One Family Rule", "body": "Keine zweite Schrift; 400, 600, 700, kursiv für Betonung.", "section": "typography" },
      { "name": "The Flat-By-Default Rule", "body": "Karten haben keinen Schatten; Zustand zeigt sich über Randfarbe und Hintergrund.", "section": "elevation" }
    ],
    "dos": [
      "Do Moosgrün (#1E6B4F) sparsam einsetzen: Links, Häkchen, gewählter Zustand, ein Hauptbutton.",
      "Do jede neue Fläche als Karte mit 1px Haarlinie (#E4DED3) auf Papier bauen, 6px Radius, ohne Schatten.",
      "Do jede Farbe als Hell/Dunkel-Paar anlegen und Kontrast ≥ 4,5:1 prüfen.",
      "Do Ziele auf mindestens 44px Höhe bringen, Buttons auf 48px."
    ],
    "donts": [
      "Don't Fraunces, Inter oder verspielte Schriftschnitte einführen.",
      "Don't mehr als einen gefüllten Button pro Ansicht setzen.",
      "Don't Schatten, Verläufe oder bunte Akzentflächen zu Karten hinzufügen.",
      "Don't Anbieter mit Werbesprache oder Affiliate-Hinweisen aufmachen.",
